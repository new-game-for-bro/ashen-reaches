extends SceneTree
func _initialize() -> void:
	call_deferred("run_test")
func run_test() -> void:
	var game = load("res://scenes/story/prologue.tscn").instantiate()
	root.add_child(game)
	await process_frame
	assert(game.stage == "duel")
	game._on_attack()
	assert(game.stage == "duel")
	game.player.global_position = Vector3(0, 0, -4)
	game._on_attack()
	assert(game.stage == "dodge")
	game._on_dodge()
	assert(game.stage == "counter")
	game._on_attack()
	assert(game.stage == "countdown")
	game._process(9.0)
	assert(game.stage == "exit")
	game._on_interact()
	assert(game.stage == "gate")
	game._on_interact()
	assert(game.stage == "gate")
	game.player.global_position = Vector3(0, 0, -38)
	game._on_interact()
	assert(game.stage == "train")
	game.player.global_position = Vector3(25, 0, -38)
	game._on_interact()
	assert(game.stage == "ending")
	game._on_interact()
	assert(game.stage == "ending")
	game.train.position.x = 70
	game._on_interact()
	assert(game.stage == "complete")
	print("PASS: duel, dodge, countdown, gate, train and ending")
	quit()
